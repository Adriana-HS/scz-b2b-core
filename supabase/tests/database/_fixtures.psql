-- ============================================================================
-- Fixtures compartidas por las pruebas pgTAP (se incluyen con \ir y se revierten
-- con el ROLLBACK de cada archivo). Dos tenants: A (importadora) y B (clínica).
-- ============================================================================
CREATE EXTENSION IF NOT EXISTS pgtap WITH SCHEMA extensions;
SET search_path = public, extensions;

-- En Supabase el rol `postgres` no es superusuario: necesita pertenecer a app_backend
-- para poder hacer SET ROLE en las pruebas (se revierte con el ROLLBACK).
DO $$ BEGIN EXECUTE format('GRANT app_backend TO %I', current_user); END $$;

-- Helpers para cambiar de identidad dentro de la transacción de prueba
CREATE SCHEMA IF NOT EXISTS tests;
GRANT USAGE ON SCHEMA tests TO anon, authenticated, app_backend;

CREATE OR REPLACE FUNCTION tests.as_user(p_uid uuid, p_aal text DEFAULT 'aal1') RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('request.jwt.claims',
        json_build_object('sub', p_uid, 'role', 'authenticated', 'aal', p_aal)::text, true);
    PERFORM set_config('app.current_org_id', '', true);
    EXECUTE 'SET LOCAL ROLE authenticated';
END $$;

CREATE OR REPLACE FUNCTION tests.as_backend(p_org uuid, p_actor text DEFAULT 'BOT') RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('request.jwt.claims', '', true);
    PERFORM set_config('app.current_org_id', coalesce(p_org::text, ''), true);
    PERFORM set_config('app.actor', p_actor, true);
    EXECUTE 'SET LOCAL ROLE app_backend';
END $$;

CREATE OR REPLACE FUNCTION tests.as_anon() RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('request.jwt.claims', '', true);
    PERFORM set_config('app.current_org_id', '', true);
    EXECUTE 'SET LOCAL ROLE anon';
END $$;

CREATE OR REPLACE FUNCTION tests.reset() RETURNS void
LANGUAGE plpgsql AS $$
BEGIN
    EXECUTE 'RESET ROLE';
    PERFORM set_config('request.jwt.claims', '', true);
    PERFORM set_config('app.current_org_id', '', true);
    PERFORM set_config('app.actor', '', true);
END $$;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA tests TO anon, authenticated, app_backend;

