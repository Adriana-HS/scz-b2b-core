# Copiar a .env (nunca subir .env). Los valores reales viven en el gestor de secretos.

# Copiar a backend/.env para correr el backend en local.
ENVIRONMENT=local   # local | test | staging | production (staging/production exigen los secretos)
LOG_LEVEL=INFO

# Base de datos (rol app_backend vía Supavisor en modo transacción)
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Supabase (solo para el StorageAdapter; nunca para consultas de datos)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# IA
LLM_API_KEY=
EMBEDDINGS_API_KEY=

# Pagos / facturación (por tenant en Vault; aquí solo credenciales de plataforma si aplica)
OPENBCB_CLIENT_ID=
OPENBCB_CLIENT_SECRET=

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
