# Copiar a .env (nunca subir .env). Los valores reales viven en el gestor de secretos.

# Copiar a backend/.env para correr el backend en local.
ENVIRONMENT=local   # local | test | staging | production (staging/production exigen los secretos)
LOG_LEVEL=INFO

# Base de datos (rol app_backend vía Supavisor en modo transacción)
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Supabase (solo para el StorageAdapter; nunca para consultas de datos)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=           # versión fijada de la Graph API, p. ej. v23.0 (obligatoria en staging y producción)
# Token de cada número: el nombre va en whatsapp_channels.access_token_ref; el valor, aquí (prefijo WA_TOKEN_).
# WA_TOKEN_IMPORTADORA_A=

# IA (#22). La clave es un secreto. El modelo va por su identificador EXACTO (nunca -latest) y
# sus precios en USD por millón de tokens, según la página de precios del proveedor: sin los
# cuatro precios el proceso no arranca (el costo se registraría en cero).
LLM_API_KEY=
LLM_MODEL=                              # claude-haiku-5-5 (ADR-0018)
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
LLM_PRICE_CACHE_READ_USD_PER_MTOK=
LLM_PRICE_CACHE_WRITE_USD_PER_MTOK=
EMBEDDINGS_API_KEY=

# Pagos / facturación (por tenant en Vault; aquí solo credenciales de plataforma si aplica)
OPENBCB_CLIENT_ID=
OPENBCB_CLIENT_SECRET=

# Worker (ver backend/README.md). JOB_LEASE_S debe ser mayor que JOB_TIMEOUT_S.
WORKER_CONCURRENCY=16
WORKER_POLL_INTERVAL_S=0.25
JOB_TIMEOUT_S=60
JOB_LEASE_S=300

# Observabilidad (docs/observability.md). Los logs salen siempre en JSON por stdout (nivel: LOG_LEVEL).
# Sin endpoint no se exportan trazas ni métricas; sin DSN no hay Sentry.
OTEL_EXPORTER_OTLP_ENDPOINT=        # colector OTLP/HTTP, p. ej. https://otlp-gateway-<región>.grafana.net/otlp (https en staging/producción)
OTEL_EXPORTER_OTLP_HEADERS=         # secreto: autenticación del colector, p. ej. Authorization=Basic <token>
SENTRY_DSN=                         # secreto